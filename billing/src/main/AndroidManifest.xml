<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/screen_main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".MainActivity"
    android:padding="16dp">

    <!-- Toolbar -->
    <androidx.appcompat.widget.Toolbar
        android:id="@+id/tool
bar"
        android:layout_width="match_parent"
        android:layout_height="?attr/actionBarSize"
        android:background="?attr/colorPrimary"
        android:theme="@style/ThemeOverlay.AppCompat.Dark.ActionBar" />

    <!-- Tank Status Display -->
    <TextView
        android:id="@+id/tank_status"
        android:layout_below="@id/toolbar"
        android:layout_marginTop="32dp"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Tank Level: 2"
        android:textSize="20sp"
        android:textStyle="bold"
        android:layout_centerHorizontal="true" />

    <!-- Progress Bar -->
    <ProgressBar
        android:id="@+id/tank_bar"
        android:layout_below="@id/tank_status"
        android:layout_marginTop="16dp"
        android:layout_width="match_parent"
        android:layout_height="20dp"
        android:max="2"
        android:progress="2"
        style="?android:attr/progressBarStyleHorizontal"
        android:progressTint="#4CAF50" />

    <!-- Drive Button -->
    <Button
        android:id="@+id/button_drive"
        android:layout_below="@id/tank_bar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Drive"
        android:layout_marginTop="24dp" />

    <!-- Refill Button -->
    <Button
        android:id="@+id/button_refill"
        android:layout_below="@id/button_drive"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Refill"
        android:layout_marginTop="12dp" />

    <!-- Wait Screen (hidden by default) -->
    <LinearLayout
        android:id="@+id/screen_wait"
        android:visibility="gone"
        android:orientation="vertical"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:gravity="center"
        android:background="#CC000000">

        <ProgressBar android:layout_width="wrap_content"
            android:layout_height="wrap_content" />

        <TextView
            android:layout_marginTop="16dp"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Please wait..."
            android:textColor="#FFF" />
    </LinearLayout>
</RelativeLayout>
